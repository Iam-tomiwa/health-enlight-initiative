NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Required while the Sanity dataset is private. Use a Viewer token only.
SANITY_API_READ_TOKEN=

# Brevo (server-side only; never prefix these with NEXT_PUBLIC_)
BREVO_API_KEY=
BREVO_SENDER_EMAIL= # Must be a verified sender in Brevo
BREVO_SENDER_NAME=The Health enLight Initiative
BREVO_TO_EMAIL=thehealthenlightinitiative@gmail.com
BREVO_NEWSLETTER_LIST_ID= # Newsletter + upcoming public event announcements
BREVO_VOLUNTEER_LIST_ID= # Volunteer application and coordination emails
